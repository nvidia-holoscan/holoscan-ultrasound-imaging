+#include <holoscan/holoscan.hpp>
+
+namespace hololink::operators {
+
+class RoceTransmitter {
+public:
+    using Tensor = std::shared_ptr<holoscan::Tensor>;
+
+    struct Error : public std::runtime_error {
+        using std::runtime_error::runtime_error;
+    };
+
+    struct ConnectionInfo {
+        uint32_t qp_num;
+    };
+
+    RoceTransmitter(
+        const std::string& ibv_name,
+        unsigned ibv_port,
+        size_t buffer_size,
+        size_t queue_size,
+        const std::string& hololink_ip,
+        uint32_t ibv_qp);
+    ~RoceTransmitter();
+
+    RoceTransmitter(const RoceTransmitter&) = delete;
+    RoceTransmitter& operator=(const RoceTransmitter&) = delete;
+
+    void start();
+    void stop();
+    bool flush(std::chrono::milliseconds timeout = std::chrono::milliseconds(0));
+    void queue_buffer(const Tensor& buffer);
+    void queue_host_buffer(const void* data, size_t nbytes);
+    uint32_t qp_num() const;
+
+private:
+    class Buffer;
+    struct Resource;
+
+    bool connect();
+    bool send(uint64_t id, std::shared_ptr<Buffer> buffer);
+    void completion_thread();
+    void transmission_thread();
+    std::mutex& get_lock();
+
+    std::string ibv_name_;
+    unsigned ibv_port_;
+    size_t buffer_size_;
+    size_t queue_size_;
+    std::string hololink_ip_;
+    uint32_t ibv_qp_;
+
+    std::unique_ptr<Resource> resource_;
+    std::mutex mutex_;
+    std::condition_variable cv_;
+    bool flushing_ {};
+    std::atomic<bool> running_ {};
+    std::thread completion_thread_;
+    std::thread transmission_thread_;
+};
+
+} // namespace hololink::operators
